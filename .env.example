# LLM keys (only the providers used below are required)
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
# Google AI Studio: one key for all platform models (Gemini, Gemma)
GOOGLE_AI_STUDIO_API_KEY=

# "provider:model", provider: groq | openrouter | mistral | google
LLM_MODEL=groq:qwen/qwen3.8-27b
AUDITOR_MODEL=openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
# Google example (tested 17.10.2026):
# LLM_MODEL=google:gemini-3.5-flash-lite
# AUDITOR_MODEL=google:gemini-3.8-flash

# Thinking level per role, Google only: minimal | low | medium | high
# LLM_MODEL: thinking off (minimal); AUDITOR_MODEL: thinking allowed, quality matters more there
LLM_THINKING_LEVEL=minimal
AUDITOR_THINKING_LEVEL=minimal

# live: call API and write cache; replay: read cache only (no key needed)
LLM_MODE=replay

# Retrieval: bm25 | dense | hybrid
RETRIEVER=hybrid
EMBED_MODEL=deepvk/USER2-base
